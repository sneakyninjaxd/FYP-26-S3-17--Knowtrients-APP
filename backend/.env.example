# Local development: SQLite needs no database server.
DATABASE_URL=sqlite:///./dev.db

# Any long random string for local use. Render has its own value set.
JWT_SECRET_KEY=change-me-to-something-long-and-random

# Free key from https://fdc.nal.usda.gov/api-key-signup/
# Only needed to run ml/import_usda.py; the API is not called at request time.
USDA_API_KEY=
