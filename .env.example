# Copy this file to .env and set the value to your deployed backend URL.
# Every team member should point this at the SAME shared backend so you're
# all testing against the same database.
#
# Once deployed on Railway/Render, it'll look like:
# EXPO_PUBLIC_API_URL=https://knowtrients-api.up.railway.app
#
# For local-only testing against your own machine instead, use:
# EXPO_PUBLIC_API_URL=http://localhost:8000

EXPO_PUBLIC_API_URL=https://your-app-name.up.railway.app
